<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for push notifications: an upward trend line. Android draws
     notification icons as a flat white silhouette, so this is a single white
     stroke on transparent — no colour, no fill. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M3,17 L9,11 L13,15 L20,8 M15,8 L20,8 L20,13"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
