<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background_light" />
    <foreground>
        <layer-list>
            <item android:width="108dp" android:height="108dp" android:gravity="fill">
                <inset
                    android:insetLeft="28%"
                    android:insetTop="33.8%"
                    android:insetRight="28%"
                    android:insetBottom="33.8%">
                    <bitmap
                        android:src="@drawable/ic_launcher_mark_light"
                        android:gravity="fill"
                        android:filter="true" />
                </inset>
            </item>
        </layer-list>
    </foreground>
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
